# Copy to ~/.config/franziska/.env (outside the repo) and link it here: ln -s ~/.config/franziska/.env .env
# Run with: uv run --env-file .env python -m franziska.bot
FRANZISKA_TELEGRAM_TOKEN=
# Comma-separated Telegram user ids allowed to talk to the bot. Send /whoami to the bot to learn yours.
FRANZISKA_ALLOWED_IDS=
FRANZISKA_MODEL=gemma4:12b
# llama-server for every local call: agents, router, triage, mail (deploy/franziska-llm.service, DESIGN decision 19).
# Empty: everything runs on Ollama with FRANZISKA_MODEL.
# FRANZISKA_BASE_URL=http://localhost:8080/v1
FRANZISKA_THINKING=0
FRANZISKA_TIMEZONE=Europe/Rome
# Morning brief time (local), empty to disable
FRANZISKA_BRIEF_AT=07:30
# Evening check-in: open tasks with ✅ buttons, tomorrow's plan. Empty to disable
FRANZISKA_EVENING_AT=20:00
# 1 = the brief also lists charges expected this week and budget warnings, and a monthly summary arrives on the 1st
FRANZISKA_BRIEF_MONEY=1
# Your name as the banks write it ('Mario Rossi'): tells transfers between your own accounts from payments to others
# (finance/links.py). Empty: only Revolut top-ups are recognised.
# FRANZISKA_OWNER_NAME=
# AnyJev router: 1 = route each message automatically, 0 = use the /life and /money modes
FRANZISKA_ROUTER=1
FRANZISKA_ROUTER_MIN_P=0.6
# FRANZISKA_ROUTER_MODEL=        # default: FRANZISKA_MODEL (no model swaps on a 12 GB GPU)
# /think: ChatGPT through pi. Sign in once with: pi, then /login openai
FRANZISKA_PI_MODEL=openai/gpt-5.5

# --- Cloud model for some routes (franziska/llm.py, DESIGN decision 31). Empty: everything stays local ---
# Only chat and markets may be listed (no personal data: a cloud chat turn gets no profile memory, the market report
# reads public news). The schedule, notes, money and mail never leave this machine; the router (AnyJev) stays local.
# A failed cloud call (no credit, outage) is answered by the local model. /usage: tokens and cost per route.
# OpenRouter: zero-retention, no-training endpoints only, no 4-bit quantisations (llm.OPENROUTER_PROVIDER).
# FRANZISKA_CLOUD_MODEL=openrouter:deepseek/deepseek-v4-pro      # or deepinfra:google/gemma-4-26b-a4b-it
# FRANZISKA_CLOUD_ROUTES=chat,markets
# FRANZISKA_CLOUD_ZDR=1                                          # 0: allow endpoints that retain/train (a :free model; markets only)
# FRANZISKA_SEES=                                               # who sees what (franziska/privacy.py), e.g. chat=public,personal,money
# FRANZISKA_CLOUD_REASONING=                                     # '' = the model's default; none | low | medium | high
# OPENROUTER_API_KEY=                                            # openrouter.ai → Keys (set a monthly credit limit)
# DEEPINFRA_API_KEY=                                             # deepinfra.com → API keys

# --- Claude on your subscription (franziska/claude.py). Sign in once: claude, then /login. Empty: off ---
# Claude Code's own login only: API-key variables are blanked for it, and a run that would bill a key is refused.
# Routes: any of llm.CLAUDE_OK (life, chat, web, pc, plan, summary, learn, code) or 'all'; never money, mail or a
# workflow. A Claude run sees public and personal data (privacy.CLAUDE_SEES), never money or mail. A failed call
# (plan limit, not signed in) is answered by the local model; /usage counts the tokens.
# FRANZISKA_CLAUDE_MODEL=sonnet                                  # sonnet | opus | haiku | a model id
# FRANZISKA_CLAUDE_ROUTES=chat,life
# FRANZISKA_CLAUDE_EFFORT=                                       # '' = Claude Code's default; low | medium | high | max
# FRANZISKA_CLAUDE_TIMEOUT_S=300                                 # one step (a reply or a tool call)
# FRANZISKA_DATA_DIR=~/.local/share/franziska         # databases, memory, Google token: outside the repo
# FRANZISKA_OLLAMA_BASE_URL=http://localhost:11434/v1   # on the box: http://<desktop>:11434/v1 (over Tailscale)

# --- Always-on box (deploy/BOX.md) ---
# FRANZISKA_ROUTER_VOCAB=~/.local/share/franziska/router-vocab.gguf          # from: python -m franziska.export_vocab (on the desktop)
# FRANZISKA_DESKTOP_MAC=aa:bb:cc:dd:ee:ff                 # desktop NIC, for Wake-on-LAN
# FRANZISKA_DESKTOP_BROADCAST=192.168.1.255
# Desktop off: ask (buttons) | cloud (ChatGPT now, wake in background) | wake (wait for it)
FRANZISKA_WHEN_OFF=ask
# FRANZISKA_WAKE_TIMEOUT_S=180

# --- Google: Calendar read/write, Gmail read-only. Sign in once: python -m franziska.google.auth (see BOX.md) ---
FRANZISKA_GOOGLE=0
# FRANZISKA_GOOGLE_CALENDAR=primary
# FRANZISKA_MAIL_EVERY_MIN=10                            # 0 disables mail

# --- Open-ended email: local mail agent over gog (gogcli): search, read, drafts, labels, archive; never sends ---
# Sign in once: gog auth credentials set ~/.config/franziska/client_secret.json && gog auth add you@gmail.com --services gmail
# (README, "Email agent").
# FRANZISKA_GOG_ACCOUNT=you@gmail.com
# FRANZISKA_MAIL_MODEL=                                  # default: FRANZISKA_MODEL on the same server
# FRANZISKA_MAIL_BASE_URL=http://localhost:8091/v1       # default: FRANZISKA_BASE_URL (docs/MODEL_NOTES.md)
# FRANZISKA_MAIL_THINKING=1
# FRANZISKA_MAIL_REASONING=medium                        # llama-server only: the template's reasoning_effort
# GOG_KEYRING_BACKEND=file                               # headless/systemd: encrypted file keyring
# GOG_KEYRING_PASSWORD=

# --- Web UI: uv run --env-file .env python -m franziska.web (franziska/web/app.py) ---
# Without a token only a browser on this machine gets in. Over Tailscale: set a long random token
# (python -c "import secrets; print(secrets.token_urlsafe(32))"), run `tailscale serve --bg 8765`, open
# https://<box>.<tailnet>.ts.net/login?token=<token> once on each device; then "Add to home screen".
# FRANZISKA_WEB_HOST=127.0.0.1
# FRANZISKA_WEB_PORT=8765
# FRANZISKA_WEB_TOKEN=

# --- Market report (franziska/market): a PDF on weekdays, the weekly edition on Mondays; /markets runs it now ---
# Public data only goes to the model (names, tickers, articles); the portfolio overlay is computed locally.
# FRANZISKA_MARKET_AT=07:30                              # empty: no push (needs FRANZISKA_BRIEF_MONEY=1)
# FRANZISKA_MARKET_LANG=en                               # en | it: the report's language
# FRANZISKA_MARKET_MAIL=1                                # mail each report PDF to your own Gmail (needs the
#                                                        gmail.send scope: rerun python -m franziska.google.auth)
# FRANZISKA_SEARXNG_URL=http://127.0.0.1:8888            # deploy/searxng: web route + brief searches (else DDG/Google News)

# --- Voice notes (franziska/voice.py): transcribed on this machine's CPU, never sent anywhere ---
# FRANZISKA_VOICE_MODEL=large-v3-turbo                   # faster-whisper model; small is faster; empty: off
# FRANZISKA_VOICE_DEVICE=cpu                             # cuda only if VRAM is free next to llama-server

# --- Nightly backups at 04:00 (franziska/backup.py): every *.sqlite and the memory files, one folder a night ---
# FRANZISKA_BACKUP_DIR=                                  # default: <data dir>/backup (same disk: point it elsewhere)
# FRANZISKA_BACKUP_KEEP=14

# --- Document library (franziska/library.py): every document sent or read, searched by words and meaning ---
# FRANZISKA_EMBED_URL=http://127.0.0.1:8081              # deploy/franziska-embed.service (CPU); empty: words only
# FRANZISKA_RERANK_URL=                                  # a llama-server --reranking; off: 6.5 s a query on CPU

# --- Sandboxed data code (franziska/sandbox.py): created once with `python -m franziska.sandbox bootstrap` ---
# No agent gets a host shell: this venv is mounted read-only in bubblewrap; jobs get no $HOME, secrets or network.
# FRANZISKA_SANDBOX_VENV=~/.local/share/franziska/sandbox-venv
# FRANZISKA_SANDBOX_TIMEOUT_S=120

# --- Coding jobs (franziska/code.py, /code, the web UI's Code view): an agent in the sandbox, you review the branch ---
# Repositories a job may change (name=path, comma-separated); 'scratch' (a new empty one) always works.
# FRANZISKA_CODE_REPOS=franziska=~/src/franziska
# FRANZISKA_CODE_MINUTES=30                             # a job's wall clock
# FRANZISKA_CODE_STEPS=60                               # commands per job
# FRANZISKA_CODE_THINKING=1                             # the model reasons before each step

# --- This computer (franziska/pc.py): the 🖥 PC route; moves, trash, restarts and coding jobs are buttons ---
# FRANZISKA_PC=1
# FRANZISKA_PC_FOLDERS=~/Documents,~/Downloads          # default: the XDG user folders that exist + the code repos

# Assistants of your own, outside this repo (franziska/modules.py, CONTRIBUTING.md): import paths, each with a MODULE.
# Put their folder on PYTHONPATH. Empty: only the built-in ones.
# FRANZISKA_MODULES=mymodules.garden

# --- Traces (franziska/obs.py): always in <data dir>/traces.sqlite, 30 days; COMMANDS.md "Logs and traces" ---
# FRANZISKA_OTLP=http://localhost:6006/v1/traces        # also send them to a local Phoenix (uvx arize-phoenix serve)
