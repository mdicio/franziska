#!/usr/bin/env bash
# Refuses a push that would carry the pre-public history (it holds real figures) anywhere but the private archive.
# That history starts at OLD_ROOT and lives on the branch archive/pre-public; the public main starts afresh.
# Enabled with the other hooks: git config core.hooksPath .githooks
set -euo pipefail

remote_url="$2"
OLD_ROOT=94092e93e946f2c15ce5671cd61be004deecaf31
PRIVATE_REMOTE='FranziskaSecretary(\.git)?$'  # the only place the old history may go

[[ "$remote_url" =~ $PRIVATE_REMOTE ]] && exit 0

zero=0000000000000000000000000000000000000000
archive=$(git rev-parse -q --verify archive/pre-public || true)
fail=0
while read -r local_ref local_sha remote_ref _; do
  [[ "$local_sha" == "$zero" ]] && continue  # a branch deletion
  if [[ "$local_ref" == refs/heads/archive/* || "$remote_ref" == refs/heads/archive/* ]]; then
    echo "pre-push: $local_ref is an archive branch; it never goes to $remote_url" >&2
    fail=1
    continue
  fi
  if git rev-list "$local_sha" | grep -qx "$OLD_ROOT"; then
    echo "pre-push: $local_ref contains the pre-public history (root ${OLD_ROOT:0:7}); refusing $remote_url" >&2
    fail=1
  elif [[ -n "$archive" ]] && git merge-base "$local_sha" "$archive" >/dev/null 2>&1; then
    echo "pre-push: $local_ref shares commits with archive/pre-public; refusing $remote_url" >&2
    fail=1
  fi
done
exit $fail
