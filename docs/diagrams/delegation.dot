// Three ways work moves between assistants (delegation.py, plan.py, core.py). Render: docs/diagrams/render.sh
digraph delegation {
  graph [rankdir=TB, fontname="Noto Sans", bgcolor="white", pad=0.35, nodesep=0.3, ranksep=0.35,
         label="Assistants that pass work on: hand_off, ask, plan", labelloc=t, fontsize=20];
  node  [fontname="Noto Sans", fontsize=11, shape=box, style="rounded,filled", penwidth=1.3, margin="0.16,0.07"];
  edge  [fontname="Noto Sans", fontsize=10, color="#546E7A", arrowsize=0.75, penwidth=1.2];

  subgraph cluster_hand {
    label="hand_off(assistant, why): 'this whole message is not mine'"; style="rounded,filled"; fillcolor="#F8F5FD"; color="#B39DDB"; fontsize=13;
    h1 [label="chat run\n'cerca le notizie di oggi'", fillcolor="#E8F5E9", color="#43A047"];
    h2 [label="raise HandOff(web)\nrun stops, logged 'hand_off → web'", fillcolor="#EDE7F6", color="#5E35B1"];
    h3 [label="web run on the same message\n(no hand_off tool: no ping-pong)\nreply labelled 💬 Chat → 🌐 Web", fillcolor="#E8F5E9", color="#43A047"];
    {rank=same; h1 -> h2 -> h3;}
    h2 -> hn [style=invis];
    hn [label="not when: the chat is pinned · the run already wrote ·\na document goes only to life / money / chat", shape=note, fillcolor="#FFFFFF", color="#B39DDB", fontsize=10];
  }

  subgraph cluster_ask {
    label="ask(assistant, request): 'I need a piece from someone else'"; style="rounded,filled"; fillcolor="#F8F5FD"; color="#B39DDB"; fontsize=13;
    a1 [label="money run\n'quanto ho pagato per la bolletta\nche mi è arrivata via mail?'", fillcolor="#E8F5E9", color="#43A047"];
    a2 [label="Core.delegate(mail, request)\nno history · own usage limit ·\nread-only: writes → buttons\n(unless the user's words asked)", fillcolor="#EDE7F6", color="#5E35B1"];
    a3 [label="StepResult\ntext · sources (evidence for the\ncaller's reply check) · proposals ·\ntainted? · wrote", fillcolor="#ECEFF1", color="#546E7A"];
    {rank=same; a1 -> a2 [label=" ≤ 2 per run"]; a2 -> a3;}
    a3 -> a1 [label=" answer", style=dashed, constraint=false];
    a2 -> an [style=invis];
    an [label="ASK table: life → mail · money → life, mail\nnobody asks web (a written request could\ncarry personal data into a query)", shape=note, fillcolor="#FFFFFF", color="#B39DDB", fontsize=10];
  }

  subgraph cluster_plan {
    label="plan: 'this message asks several assistants for things'"; style="rounded,filled"; fillcolor="#F8F5FD"; color="#B39DDB"; fontsize=13;
    p0 [label="'mettila in agenda e\ncercami l'indirizzo'", fillcolor="#E3F2FD", color="#1E88E5"];
    p1 [label="AnyJev: several things?\np ≥ 0.5", fillcolor="#FFF8E1", color="#F9A825"];
    p2 [label="planner (NativeOutput(Plan))\nreads only the message + what\neach assistant does, never data", fillcolor="#EDE7F6", color="#5E35B1"];
    p3 [label="steps ≤ 4, one per assistant,\nfinders before doers\nuses_previous → gets earlier answers\n(web never does)", fillcolor="#EDE7F6", color="#5E35B1"];
    p4 [label="each step → Core.delegate\nwith the user's words as authorization", fillcolor="#EDE7F6", color="#5E35B1"];
    p5 [label="reply: each answer\nunder its label\n(no composer generation)", fillcolor="#E3F2FD", color="#1E88E5"];
    {rank=same; p0 -> p1 -> p2 -> p3 -> p4 -> p5;}
  }
  hn -> a2 [style=invis]; an -> p2 [style=invis];
}
