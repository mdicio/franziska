// The secretary: Life, tasks, notes, Google Calendar, reminders, MCP (secretary/, google/, mcp_server.py)
digraph secretary {
  graph [rankdir=LR, fontname="Noto Sans", bgcolor="white", pad=0.35, nodesep=0.28, ranksep=0.6,
         label="📅 Secretary: one service (Life), many front doors", labelloc=t, fontsize=20];
  node  [fontname="Noto Sans", fontsize=11, shape=box, style="rounded,filled", penwidth=1.3, margin="0.16,0.07"];
  edge  [fontname="Noto Sans", fontsize=10, color="#546E7A", arrowsize=0.75, penwidth=1.2];

  subgraph cluster_doors {
    label="Front doors (thin wrappers)"; style="rounded,filled"; fillcolor="#F5F9FF"; color="#90CAF9"; fontsize=13;
    agent [label="secretary/agent.py\nPydantic AI agent: add_task · add_appointment ·\nedit_task · complete · move · cancel · agenda ·\nopen_tasks · plan_overview · free_time · shift_date ·\nreminder_rule · remember · recall · forget\n(+ add_bill borrowed from finance)", fillcolor="#E8F5E9", color="#43A047"];
    mcp [label="mcp_server.py (FastMCP, stdio)\n15 tools + market_report\ntimes as plain strings", fillcolor="#E3F2FD", color="#1E88E5"];
    cmds [label="bot commands, no model\n/today /week /tasks /done\n/notes /undo · ✅ / snooze taps", fillcolor="#E3F2FD", color="#1E88E5"];
    cli [label="python -m franziska.secretary\n'…' or --brief", fillcolor="#E3F2FD", color="#1E88E5"];
  }
  clients [label="Claude Code (.mcp.json) · pi · Codex\nthe mail agent's 'life' server\n/think via pi → ChatGPT", fillcolor="#FAFAFA", color="#9E9E9E", style="rounded,filled,dashed"];

  life [label="Life (secretary/service.py)\nevery rule, once: refuses past times,\nretries unknown ids, item ids '12' / '#12' / 'c5',\nbrief(), snooze(), undo", fillcolor="#ECEFF1", color="#546E7A"];
  pri [label="Router.priority\n(AnyJev: high · normal · low)\nRouter.reminder_rules", fillcolor="#FFF8E1", color="#F9A825"];

  subgraph cluster_data {
    label="life.sqlite (WAL, shared by bot, web and MCP server)"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#78909C"; fontsize=13;
    node [shape=cylinder, fillcolor="#FFFFFF", color="#37474F", fontsize=10];
    tasks [label="tasks\ntasks + local appointments\nrecur · remind_at · priority ·\nnagging_since · rule_id"];
    notes [label="notes + notes_fts\n(secretary/memory.py)"];
    mirror [label="calendar_events\nmirror: yesterday → +120 days,\nrecurring expanded, ids #c5"];
    rules [label="reminder_rules · undo"];
  }
  gcal [label="Google Calendar\n(home of appointments;\nyour phone's notifications)", fillcolor="#FAFAFA", color="#9E9E9E", style="rounded,filled,dashed"];

  subgraph cluster_jobs {
    label="Jobs in bot.py (no model)"; style="rounded,filled"; fillcolor="#F7F9FA"; color="#B0BEC5"; fontsize=13;
    rem [label="reminders, every 60 s\n✅ Done · +15m · +1h · +1d\nnagging by priority, 'still needed?'", fillcolor="#ECEFF1", color="#546E7A"];
    sync [label="calendar sync, every 5 min", fillcolor="#ECEFF1", color="#546E7A"];
    brief [label="brief 07:30 · evening 20:00\nSunday review 18:00", fillcolor="#ECEFF1", color="#546E7A"];
  }
  money [label="Money (finance)\nadd_bill → 'Pay X' task\nbill.paid event → complete", fillcolor="#ECEFF1", color="#546E7A"];

  agent -> life; mcp -> life; cmds -> life; cli -> life; clients -> mcp [label=" stdio"];
  life -> tasks; life -> notes; life -> rules; life -> mirror [label=" reads"];
  life -> gcal [label=" writes first\n add · move · cancel"]; gcal -> mirror [label=" sync", style=dashed];
  life -> pri [style=dashed, label=" no priority said"];
  rem -> tasks; sync -> gcal [style=dashed]; brief -> life;
  money -> life [color="#43A047", label=" one way: finance → secretary"];
}
